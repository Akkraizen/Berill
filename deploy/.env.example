DATABASE_PASSWORD=change-to-your-pass
BIND_ADDRESS=127.0.0.1
# HUB_TOKENS=
# SYNC_PORT=8080
# UPDATES_PORT=8081
# BACKUP_KEEP_DAYS=14
# BACKUP_HOUR=3
# BACKUP_PATH=./backups
# RELEASES_PATH=./releases
# TZ=Europe/Moscow
# SYNC_IMAGE=ghcr.io/akkraizen/berill-sync:latest
# UPDATES_IMAGE=ghcr.io/akkraizen/berill-updates:latest

# Optional off-server encrypted backup, enable only after creating a repository.
# RESTIC_REPOSITORY=s3:https://s3.example.com/bucket/berill
# RESTIC_PASSWORD=replace-with-a-long-unique-password
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# RESTIC_KEEP_DAILY=14

# S3 attachment storage (default local; private bucket must already exist).
# ATTACHMENTS_BACKEND=s3
# ATTACHMENTS_S3_ENDPOINT=https://s3.example.com
# ATTACHMENTS_S3_BUCKET=berill-attachments
# ATTACHMENTS_S3_PREFIX=attachments
# ATTACHMENTS_S3_PATH_STYLE=true
# ATTACHMENTS_AWS_ACCESS_KEY_ID=
# ATTACHMENTS_AWS_SECRET_ACCESS_KEY=
# ATTACHMENTS_AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1
# AWS_SESSION_TOKEN=
# Use a separate bucket/account for RESTIC_REPOSITORY and backup AWS credentials above.
